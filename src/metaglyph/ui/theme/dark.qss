/* Metaglyph Modern Dark Theme Stylesheet */

/* Global Reset & Base Typography */
QWidget {
    color: #f1f5f9;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

/* Root Windows, Views, & Main Containers */
QMainWindow, #centralWidget, QStackedWidget,
#discoverView, #searchView, #systemView,
#discoverContainer, #cardsContainer, #listContainer {
    background-color: #0f1117;
}

QDialog {
    background-color: #161922;
    border: 1px solid #282e3f;
    border-radius: 10px;
}

/* Scroll Areas */
QScrollArea, QAbstractScrollArea {
    background-color: #0f1117;
    border: none;
}

/* Transparent labels and basic widgets by default */
QLabel {
    background-color: transparent;
    color: #f1f5f9;
}

QFrame {
    background-color: transparent;
}

/* Sidebar Navigation */
#sidebar {
    background-color: #131620;
    border-right: 1px solid #1e2230;
    min-width: 210px;
    max-width: 250px;
}

#sidebarHeader {
    background-color: transparent;
    padding: 16px 14px 12px 14px;
}

#sidebarLogo {
    font-size: 17px;
    font-weight: 800;
    color: #818cf8;
    letter-spacing: 1.2px;
}

#sidebarSubtitle {
    font-size: 11px;
    color: #64748b;
    font-weight: 500;
}

#sidebarNavGroup {
    background-color: transparent;
    padding: 6px 8px;
}

QPushButton.nav-btn {
    text-align: left;
    padding: 9px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #94a3b8;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton.nav-btn:hover {
    background-color: #1c202e;
    color: #f8fafc;
}

QPushButton.nav-btn:checked {
    background-color: #202436;
    color: #818cf8;
    border-left: 3px solid #6366f1;
}

#sidebarFooter {
    padding: 12px 14px;
    border-top: 1px solid #1e2230;
    background-color: #0f1117;
}

#sidebarStatsLabel {
    font-size: 11px;
    color: #64748b;
    line-height: 1.4;
}

#sidebarVersionLabel {
    font-size: 10px;
    color: #475569;
    font-weight: 600;
}

/* Buttons */
QPushButton {
    background-color: #1c202e;
    color: #e2e8f0;
    border: 1px solid #2b3247;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #252b3d;
    border-color: #3d4663;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #181c28;
}

QPushButton:disabled {
    background-color: #141721;
    color: #475569;
    border-color: #1e2230;
}

QPushButton.primary-btn {
    background-color: #4f46e5;
    color: #ffffff;
    border: 1px solid #6366f1;
}

QPushButton.primary-btn:hover {
    background-color: #4338ca;
    border-color: #818cf8;
}

QPushButton.primary-btn:pressed {
    background-color: #3730a3;
}

QPushButton.accent-btn {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
}

QPushButton.accent-btn:hover {
    background-color: #047857;
}

QPushButton.danger-btn {
    background-color: #b91c1c;
    color: #ffffff;
    border: 1px solid #dc2626;
}

QPushButton.danger-btn:hover {
    background-color: #991b1b;
}

/* Search Bar */
#searchBarContainer {
    background-color: #161922;
    border: 1px solid #282e3f;
    border-radius: 8px;
    padding: 2px 8px;
}

#searchBarContainer:focus-within {
    border-color: #6366f1;
    background-color: #1a1e2a;
}

#searchLineEdit {
    background-color: transparent;
    color: #f8fafc;
    font-size: 13px;
    padding: 6px 4px;
    border: none;
}

#searchClearButton {
    background-color: transparent;
    color: #64748b;
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 4px;
}

#searchClearButton:hover {
    color: #e2e8f0;
    background-color: #252b3d;
}

/* Filter Bar & Chips */
#filterBar {
    background-color: transparent;
    padding: 2px 0px;
}

QPushButton.filter-chip {
    background-color: #161922;
    color: #94a3b8;
    border: 1px solid #282e3f;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton.filter-chip:hover {
    background-color: #1f2433;
    color: #f1f5f9;
    border-color: #384259;
}

QPushButton.filter-chip:checked {
    background-color: #4f46e5;
    color: #ffffff;
    border-color: #6366f1;
    font-weight: 600;
}

QCheckBox.filter-toggle {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
    spacing: 5px;
    background-color: transparent;
}

QCheckBox.filter-toggle:hover {
    color: #f1f5f9;
}

QCheckBox.filter-toggle::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid #384259;
    background-color: #161922;
}

QCheckBox.filter-toggle::indicator:checked {
    background-color: #6366f1;
    border-color: #818cf8;
}

/* Font Cards */
#fontCard {
    background-color: #161922;
    border: 1px solid #232838;
    border-radius: 8px;
    padding: 12px 14px;
    margin: 2px 0px;
}

#fontCard:hover {
    background-color: #1b202c;
    border-color: #363e54;
}

#fontCard.selected {
    border: 1.5px solid #6366f1;
    background-color: #1c2132;
}

#fontCardHeader {
    background-color: transparent;
}

#fontFamilyLabel {
    font-size: 15px;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: 0.2px;
    background-color: transparent;
}

#fontProviderBadge {
    background-color: #1f2436;
    color: #818cf8;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #2d344d;
}

#fontCategoryBadge {
    background-color: #1c202d;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #282e3f;
}

#fontStylesBadge {
    background-color: #14283b;
    color: #38bdf8;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #1d3e5e;
}

#fontNerdBadge {
    background-color: #2b1442;
    color: #c084fc;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #4a2175;
}

#fontVariableBadge {
    background-color: #0b3829;
    color: #34d399;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #145942;
}

#fontPreviewLabel {
    background-color: transparent;
    color: #e2e8f0;
    padding: 4px 0px;
}

/* Discover View Category Cards */
#categoryCard {
    background-color: #161922;
    border: 1px solid #232838;
    border-radius: 10px;
    padding: 16px;
}

#categoryCard:hover {
    background-color: #1c202e;
    border-color: #6366f1;
}

#categoryCardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #f8fafc;
    background-color: transparent;
}

#categoryCardIcon {
    font-size: 13px;
    font-weight: 700;
    background-color: transparent;
}

#categoryCardDesc {
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.4;
    background-color: transparent;
}

#categoryCardCount {
    font-size: 10px;
    color: #818cf8;
    font-weight: 600;
    background-color: #1f2436;
    padding: 2px 8px;
    border-radius: 8px;
    border: 1px solid #2d344d;
}

#spotlightCard {
    background-color: #151828;
    border: 1px solid #2e3656;
    border-radius: 10px;
    padding: 18px 22px;
}

#spotlightTitle {
    font-size: 19px;
    font-weight: 800;
    color: #c7d2fe;
    background-color: transparent;
}

#spotlightSubtitle {
    font-size: 12px;
    color: #94a3b8;
    background-color: transparent;
}

/* Detail Pane */
#detailPane {
    background-color: #131620;
    border-left: 1px solid #1e2230;
    min-width: 300px;
    max-width: 380px;
}

#detailPane QScrollArea, #detailPane QWidget {
    background-color: #131620;
}

#detailPane QLabel, #detailPane QRadioButton, #detailPane QCheckBox, #detailPane QFrame {
    background-color: transparent;
}

#detailPaneTitle {
    font-size: 17px;
    font-weight: 800;
    color: #ffffff;
    background-color: transparent;
}

#detailPaneSubtitle {
    font-size: 11px;
    color: #64748b;
    background-color: transparent;
}

#detailSectionHeader {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 6px;
    background-color: transparent;
}

#detailSampleEditor {
    background-color: #0f1117;
    border: 1px solid #232838;
    border-radius: 6px;
    padding: 6px 8px;
    color: #f8fafc;
    font-size: 12px;
}

#detailSampleEditor:focus {
    border-color: #6366f1;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background: #232838;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #6366f1;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #6366f1;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #818cf8;
}

/* Combo Box */
QComboBox {
    background-color: #161922;
    border: 1px solid #282e3f;
    border-radius: 6px;
    padding: 5px 8px;
    color: #f1f5f9;
    font-size: 11px;
}

QComboBox:hover {
    border-color: #3d4663;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #161922;
    border: 1px solid #2b3247;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
    color: #f1f5f9;
    padding: 4px;
}

/* Radio Buttons */
QRadioButton {
    color: #cbd5e1;
    font-size: 12px;
    spacing: 6px;
    background-color: transparent;
}

QRadioButton:hover {
    color: #f8fafc;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 1px solid #384259;
    background-color: #161922;
}

QRadioButton::indicator:checked {
    background-color: #6366f1;
    border-color: #818cf8;
}

/* Scroll Bars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #232838;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #384259;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #232838;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #384259;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar & Footers */
#statusBar {
    background-color: #0c0e14;
    border-top: 1px solid #1a1e2a;
    padding: 3px 10px;
    color: #64748b;
    font-size: 11px;
}

#statusLabel {
    color: #94a3b8;
    font-size: 11px;
    background-color: transparent;
}

/* Progress Bar */
QProgressBar {
    background-color: #161922;
    border: 1px solid #282e3f;
    border-radius: 4px;
    text-align: center;
    color: #f1f5f9;
    font-size: 10px;
    height: 10px;
}

QProgressBar::chunk {
    background-color: #6366f1;
    border-radius: 3px;
}

/* Tooltips */
QToolTip {
    background-color: #1c202e;
    color: #f8fafc;
    border: 1px solid #384259;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* Nerd Font Badge */
#nerdBadge {
    background-color: #1c132b;
    border: 1px solid #3f1e68;
    border-radius: 8px;
    padding: 10px;
}

#nerdBadgeTitle {
    color: #c084fc;
    font-weight: 700;
    font-size: 12px;
    background-color: transparent;
}

#nerdBadgeDesc {
    color: #94a3b8;
    font-size: 11px;
    background-color: transparent;
}

#nerdVariantCombo {
    background-color: #150d22;
    border: 1px solid #3b1875;
    border-radius: 4px;
    color: #f5d0fe;
    padding: 4px 8px;
    font-size: 11px;
}

#nerdBadgeBtn {
    background-color: #4c1d95;
    color: #f5d0fe;
    border: 1px solid #7c3aed;
    padding: 5px 10px;
    border-radius: 5px;
    font-weight: 600;
    font-size: 11px;
}

#nerdBadgeBtn:hover {
    background-color: #5b21b6;
    color: #ffffff;
    border-color: #a855f7;
}

/* Batch Action Bar (System View) */
#batchBar {
    background-color: #131620;
    border: 1px solid #232838;
    border-radius: 8px;
    padding: 6px 10px;
}

#batchSelectedLabel {
    color: #e2e8f0;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
}

#batchUninstallBtn {
    background-color: #991b1b;
    color: #fef2f2;
    border: 1px solid #dc2626;
    padding: 5px 12px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
}

#batchUninstallBtn:hover {
    background-color: #b91c1c;
    border-color: #ef4444;
}

#batchUninstallBtn:disabled {
    background-color: #161922;
    color: #475569;
    border-color: #232838;
}

/* Installed Font Family Groups & Variant Cards */
#systemFontFamilyGroup {
    background-color: #161922;
    border: 1px solid #232838;
    border-radius: 8px;
    margin-bottom: 8px;
}

#systemFontFamilyHeader {
    background-color: #1a1f2c;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom: 1px solid #232838;
}

#systemFontFamilyHeader:hover {
    background-color: #202737;
}

#systemFontCard {
    background-color: #13161f;
    border: 1px solid #1e2330;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 2px 4px;
}

#systemFontCard:hover {
    background-color: #191f2c;
    border-color: #313a4e;
}

#systemFontCard[selected="true"] {
    background-color: #1a2234;
    border-color: #4f46e5;
}

#systemFontDetailsBox {
    background-color: #0b0d13;
    border: 1px solid #1a1e2b;
    border-radius: 6px;
    padding: 10px 12px;
    margin-top: 4px;
}

#systemLoadingLabel {
    color: #818cf8;
    font-size: 13px;
    font-weight: 600;
    padding: 32px;
    background-color: transparent;
}

#systemFontPreview {
    background-color: #12141c;
    border: 1px solid #1e2433;
    border-radius: 4px;
    padding: 6px 10px;
    margin-bottom: 4px;
}

#systemFontPath {
    font-family: monospace;
    font-size: 11px;
    color: #94a3b8;
    background-color: transparent;
}

/* Installation Feedback Banners */
#installFeedbackSuccess {
    background-color: #064e3b;
    border: 1px solid #059669;
    border-radius: 6px;
    color: #a7f3d0;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 600;
}

#installFeedbackError {
    background-color: #450a0a;
    border: 1px solid #dc2626;
    border-radius: 6px;
    color: #fecaca;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 600;
}

#installStatusBadge {
    background-color: #064e3b;
    color: #34d399;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid #059669;
}
