/* Metaglyph Modern Dark Theme Stylesheet - Brand Guidelines Compliant */

/* Global Reset & Base Typography */
QWidget {
    color: #ffffff;
    selection-background-color: #771ebd;
    selection-color: #ffffff;
}

/* Base Typography for standard UI controls (exempts font preview labels) */
QMainWindow, QDialog,
QPushButton, QLineEdit, QComboBox, QRadioButton, QCheckBox,
QTabBar, QHeaderView, QTreeView, QListView, QTableView,
#sidebar, #sidebarTitle, #sidebarSubtitle, #statCard, #filterBar {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* Root Windows, Views, & Main Containers */
QMainWindow, #centralWidget, QStackedWidget,
#discoverView, #searchView, #systemView,
#discoverContainer, #cardsContainer, #listContainer {
    background-color: #120323;
}

QDialog {
    background-color: #16072b;
    border: 1px solid #371666;
    border-radius: 10px;
}

/* Scroll Areas */
QScrollArea, QAbstractScrollArea {
    background-color: #120323;
    border: none;
}

/* Transparent labels and basic widgets by default */
QLabel {
    background-color: transparent;
    color: #ffffff;
}

QFrame {
    background-color: transparent;
}

/* Sidebar Navigation */
#sidebar {
    background-color: #16072b;
    border-right: 1px solid #2a104f;
    min-width: 210px;
    max-width: 250px;
}

#sidebarHeader {
    background-color: transparent;
    padding: 14px 14px 10px 14px;
}

#sidebarLogo {
    font-size: 17px;
    font-weight: 800;
    color: #b784ff;
    letter-spacing: 1.2px;
    background-color: transparent;
    padding: 0px;
}

#sidebarSubtitle {
    font-size: 11px;
    color: #a997be;
    font-weight: 500;
}

#sidebarNavGroup {
    background-color: transparent;
    padding: 6px 8px;
}

QPushButton.nav-btn {
    text-align: left;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #c4b5d4;
    background-color: transparent;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
}

QPushButton.nav-btn:hover {
    background-color: #240d47;
    color: #ffffff;
}

QPushButton.nav-btn:checked {
    background-color: #2f105c;
    color: #ffffff;
    border-left: 3px solid #771ebd;
}

#sidebarFooter {
    padding: 12px 14px;
    border-top: 1px solid #2a104f;
    background-color: #120323;
}

#sidebarStatsLabel {
    font-size: 11px;
    color: #c4b5d4;
    line-height: 1.4;
}

#sidebarVersionLabel {
    font-size: 10px;
    color: #6e5a85;
    font-weight: 600;
}

/* Buttons */
QPushButton {
    background-color: #1b0a33;
    color: #e9e9e9;
    border: 1px solid #371666;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #260f47;
    border-color: #5c24a3;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #150729;
}

QPushButton:disabled {
    background-color: #150729;
    color: #58446e;
    border-color: #2a104f;
}

QPushButton.primary-btn {
    background-color: #771ebd;
    color: #ffffff;
    border: 1px solid #8d2cd6;
}

QPushButton.primary-btn:hover {
    background-color: #8d2cd6;
    border-color: #a847f0;
}

QPushButton.primary-btn:pressed {
    background-color: #49107f;
}

QPushButton.accent-btn {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #10b981;
}

QPushButton.accent-btn:hover {
    background-color: #047857;
}

QPushButton.danger-btn {
    background-color: #b91c1c;
    color: #ffffff;
    border: 1px solid #dc2626;
}

QPushButton.danger-btn:hover {
    background-color: #991b1b;
}

/* Search Bar */
#searchBarContainer {
    background-color: #16072b;
    border: 1px solid #371666;
    border-radius: 8px;
    padding: 2px 8px;
}

#searchBarContainer:focus-within {
    border-color: #771ebd;
    background-color: #1b0a33;
}

#searchLineEdit {
    background-color: transparent;
    color: #ffffff;
    font-size: 13px;
    padding: 6px 4px;
    border: none;
}

#searchLineEdit:focus {
    color: #ffffff;
}

#searchClearButton {
    background-color: transparent;
    color: #8a769f;
    border: none;
    font-size: 14px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 4px;
}

#searchClearButton:hover {
    color: #ffffff;
    background-color: #260f47;
}

/* Filter Bar & Chips */
#filterBar {
    background-color: transparent;
    padding: 6px 0px;
}

QPushButton.filter-chip {
    background-color: #16072b;
    color: #c4b5d4;
    border: 1px solid #371666;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton.filter-chip:hover {
    background-color: #240d47;
    color: #ffffff;
    border-color: #5c24a3;
}

QPushButton.filter-chip:checked {
    background-color: #771ebd;
    color: #ffffff;
    border-color: #8d2cd6;
    font-weight: 600;
}

QCheckBox.filter-toggle {
    color: #c4b5d4;
    font-size: 11px;
    font-weight: 500;
    spacing: 5px;
    background-color: transparent;
}

QCheckBox.filter-toggle:hover {
    color: #ffffff;
}

QCheckBox.filter-toggle::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid #371666;
    background-color: #16072b;
}

QCheckBox.filter-toggle::indicator:checked {
    background-color: #771ebd;
    border-color: #8d2cd6;
}

/* Font Cards */
#fontCard {
    background-color: #16072b;
    border: 1px solid #2a104f;
    border-radius: 8px;
    padding: 14px 16px;
    margin: 2px 0px;
}

#fontCard:hover {
    background-color: #1f0b3b;
    border-color: #5c24a3;
}

#fontCard.selected {
    border: 2px solid #771ebd;
    background-color: #250d48;
}

#fontCardHeader {
    background-color: transparent;
}

#fontFamilyLabel {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.2px;
    background-color: transparent;
}

#fontProviderBadge {
    background-color: #280e4d;
    color: #c084fc;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #471987;
}

#fontCategoryBadge {
    background-color: #1f0b3b;
    color: #c4b5d4;
    font-size: 10px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #371666;
}

#fontStylesBadge {
    background-color: #142347;
    color: #38bdf8;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #1e3b78;
}

#fontNerdBadge {
    background-color: #2e0d4e;
    color: #e879f9;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #6b1fad;
}

#fontVariableBadge {
    background-color: #0c3626;
    color: #34d399;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #135c41;
}

#fontPreviewErrorBadge {
    background-color: #2e1053;
    color: #f59e0b;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid #78350f;
}

#fontPreviewLabel {
    background-color: transparent;
    color: #e9e9e9;
    padding: 4px 0px;
}

/* Discover View Category Cards */
#categoryCard {
    background-color: #16072b;
    border: 1px solid #2a104f;
    border-radius: 10px;
    padding: 16px;
}

#categoryCard:hover {
    background-color: #240d47;
    border-color: #771ebd;
}

#categoryCardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    background-color: transparent;
}

#categoryCardIcon {
    font-size: 13px;
    font-weight: 700;
    background-color: transparent;
}

#categoryCardDesc {
    font-size: 12px;
    color: #c4b5d4;
    line-height: 1.4;
    background-color: transparent;
}

#categoryCardCount {
    font-size: 10px;
    color: #e879f9;
    font-weight: 600;
    background-color: #280e4d;
    padding: 2px 8px;
    border-radius: 8px;
    border: 1px solid #471987;
}

#spotlightCard {
    background-color: #1c0936;
    border: 1px solid #49107f;
    border-left: 3px solid #771ebd;
    border-radius: 10px;
    padding: 18px 22px;
}

#spotlightTitle {
    font-size: 19px;
    font-weight: 800;
    color: #f3e8ff;
    background-color: transparent;
}

#spotlightSubtitle {
    font-size: 12px;
    color: #c4b5d4;
    background-color: transparent;
}

/* Detail Pane */
#detailPane {
    background-color: #16072b;
    border-left: 1px solid #2a104f;
    min-width: 300px;
    max-width: 380px;
}

#detailPane QScrollArea, #detailPane QWidget {
    background-color: #16072b;
}

#detailPane QLabel, #detailPane QRadioButton, #detailPane QCheckBox, #detailPane QFrame {
    background-color: transparent;
}

#detailPaneTitle {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    background-color: transparent;
    margin-bottom: 2px;
}

#detailPaneSubtitle {
    font-size: 11px;
    color: #8a769f;
    background-color: transparent;
}

#detailSectionHeader {
    font-size: 11px;
    font-weight: 700;
    color: #c4b5d4;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-top: 12px;
    margin-bottom: 4px;
    background-color: transparent;
}

#detailSampleEditor {
    background-color: #120323;
    border: 1px solid #2a104f;
    border-radius: 6px;
    padding: 6px 8px;
    color: #ffffff;
    font-size: 12px;
}

#detailSampleEditor:focus {
    border-color: #771ebd;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background: #2a104f;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #771ebd;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #771ebd;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #8d2cd6;
}

/* Combo Box */
QComboBox {
    background-color: #16072b;
    border: 1px solid #371666;
    border-radius: 6px;
    padding: 5px 8px;
    color: #ffffff;
    font-size: 11px;
}

QComboBox:hover {
    border-color: #5c24a3;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #16072b;
    border: 1px solid #371666;
    selection-background-color: #771ebd;
    selection-color: #ffffff;
    color: #ffffff;
    padding: 4px;
}

/* Radio Buttons */
QRadioButton {
    color: #e9e9e9;
    font-size: 12px;
    spacing: 6px;
    background-color: transparent;
}

QRadioButton:hover {
    color: #ffffff;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 1px solid #371666;
    background-color: #16072b;
}

QRadioButton::indicator:checked {
    background-color: #771ebd;
    border-color: #8d2cd6;
}

/* Scroll Bars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2a104f;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #49107f;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2a104f;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #49107f;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar & Footers */
#statusBar {
    background-color: #0c0217;
    border-top: 1px solid #2a104f;
    padding: 3px 10px;
    color: #8a769f;
    font-size: 11px;
}

#statusLabel {
    color: #c4b5d4;
    font-size: 11px;
    background-color: transparent;
}

/* Progress Bar */
QProgressBar {
    background-color: #16072b;
    border: 1px solid #371666;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    font-size: 10px;
    height: 10px;
}

QProgressBar::chunk {
    background-color: #771ebd;
    border-radius: 3px;
}

/* Tooltips */
QToolTip {
    background-color: #1b0a33;
    color: #ffffff;
    border: 1px solid #49107f;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* Nerd Font Badge */
#nerdBadge {
    background-color: #1f0b35;
    border: 1px solid #49107f;
    border-radius: 8px;
    padding: 10px;
}

#nerdBadgeTitle {
    color: #e879f9;
    font-weight: 700;
    font-size: 12px;
    background-color: transparent;
}

#nerdBadgeDesc {
    color: #c4b5d4;
    font-size: 11px;
    background-color: transparent;
}

#nerdVariantCombo {
    background-color: #16072b;
    border: 1px solid #49107f;
    border-radius: 4px;
    color: #f5d0fe;
    padding: 4px 8px;
    font-size: 11px;
}

#nerdBadgeBtn {
    background-color: #771ebd;
    color: #ffffff;
    border: 1px solid #8d2cd6;
    padding: 5px 10px;
    border-radius: 5px;
    font-weight: 600;
    font-size: 11px;
}

#nerdBadgeBtn:hover {
    background-color: #8d2cd6;
    color: #ffffff;
    border-color: #a847f0;
}

/* Batch Action Bar (System View) */
#batchBar {
    background-color: #16072b;
    border: 1px solid #2a104f;
    border-radius: 8px;
    padding: 8px 14px;
}

#batchSelectedLabel {
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    background-color: transparent;
}

#batchUninstallBtn {
    background-color: #991b1b;
    color: #fef2f2;
    border: 1px solid #dc2626;
    padding: 5px 12px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 11px;
}

#batchUninstallBtn:hover {
    background-color: #b91c1c;
    border-color: #ef4444;
}

#batchUninstallBtn:disabled {
    background-color: #16072b;
    color: #58446e;
    border-color: #2a104f;
}

#expandAllBtn, #collapseAllBtn {
    background-color: #1b0a33;
    color: #c4b5d4;
    border: 1px solid #371666;
    padding: 4px 10px;
    border-radius: 5px;
    font-weight: 600;
    font-size: 11px;
}

#expandAllBtn:hover, #collapseAllBtn:hover {
    background-color: #240d47;
    color: #ffffff;
    border-color: #5c24a3;
}

#headerScanIndicator {
    color: #e879f9;
    background-color: #280e4d;
    border: 1px solid #49107f;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* Installed Font Family Groups & Variant Cards */
#systemFontFamilyGroup {
    background-color: #16072b;
    border: 1px solid #2a104f;
    border-radius: 8px;
    margin-bottom: 8px;
}

#systemFontFamilyHeader {
    background-color: #1b0a33;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom: 1px solid #2a104f;
}

#systemFontFamilyHeader:hover {
    background-color: #240d47;
}

#systemFontCard {
    background-color: #120323;
    border: 1px solid #2a104f;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 2px 4px;
}

#systemFontCard:hover {
    background-color: #1b0a33;
    border-color: #49107f;
}

#systemFontCard[selected="true"] {
    background-color: #250d48;
    border-color: #771ebd;
}

#systemFontDetailsBox {
    background-color: #0c0217;
    border: 1px solid #2a104f;
    border-radius: 6px;
    padding: 10px 12px;
    margin-top: 4px;
}

#systemLoadingLabel {
    color: #e879f9;
    font-size: 13px;
    font-weight: 600;
    padding: 32px;
    background-color: transparent;
}

#systemFontPreview {
    background-color: #120323;
    border: 1px solid #2a104f;
    border-radius: 4px;
    padding: 6px 10px;
    margin-bottom: 4px;
}

#systemFontPath {
    font-family: monospace;
    font-size: 11px;
    color: #c4b5d4;
    background-color: transparent;
}

/* Installation Feedback Banners */
#installFeedbackSuccess {
    background-color: #064e3b;
    border: 1px solid #059669;
    border-radius: 6px;
    color: #a7f3d0;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 600;
}

#installFeedbackError {
    background-color: #450a0a;
    border: 1px solid #dc2626;
    border-radius: 6px;
    color: #fecaca;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 600;
}

#installStatusBadge {
    background-color: #064e3b;
    color: #34d399;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid #059669;
}
